# Required
HDFC_API_KEY=your_investright_api_key
HDFC_API_SECRET=your_investright_api_secret

# Optional: skip the login flow entirely if you already have a valid access token
# (e.g. obtained via the browser-based /oapi/v1/login frontend flow).
#HDFC_ACCESS_TOKEN=

# Optional overrides (defaults shown)
#HDFC_BASE_URL=https://developer.hdfcsec.com
#HDFC_WS_URL=wss://developer.hdfcsec.com/wsapi/v1/session
#HDFC_SESSION_PATH=~/.hdfc_investright/session.json
#HDFC_HTTP_TIMEOUT=10
#HDFC_MAX_CONCURRENCY=5
#HDFC_REQUIRE_ORDER_CONFIRM=true

# Safety rails (all optional)
# Hard kill switch: disables place/modify/cancel entirely — data tools still work.
#HDFC_READ_ONLY=false
# Reject any order whose estimated value (price*qty, LTP-estimated for MARKET) exceeds this. 0 = off.
#HDFC_MAX_ORDER_VALUE=0
# Reject any order with quantity above this. 0 = off.
#HDFC_MAX_ORDER_QTY=0
# Window (seconds) in which an identical order is treated as an accidental duplicate.
#HDFC_DUPLICATE_ORDER_WINDOW=10
